}

.navlinks a:hover{
    color:#A87952;
}

/* HERO */

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:120px 20px 80px;
    background:
    linear-gradient(rgba(201,212,216,.65),rgba(242,238,231,.85));
}

.hero-content{
    max-width:850px;
}

.small-title{
    text-transform:uppercase;
    letter-spacing:4px;
    font-size:12px;
