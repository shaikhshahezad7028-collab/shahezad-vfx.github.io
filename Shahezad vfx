    font-weight:600;
}

h1 span{
    color:#A87952;
}

.hero p{
    max-width:650px;
    margin:28px auto;
    font-size:17px;
    line-height:1.8;
    color:#555;
}

.btn{
    display:inline-block;
    padding:15px 30px;
    border-radius:4px;
    background:#252525;
    color:white;
    text-decoration:none;
    font-size:14px;
    margin-top:10px;
    transition:.3s;
}

.btn:hover{
    background:#A87952;
}

/* SECTIONS */

section{
    padding:100px 20px;
}

.container{
    max-width:1100px;
    margin:auto;
}

.section-title{
    font-family:'Playfair Display',serif;
    font-size:48px;
    margin-bottom:15px;
}

.section-sub{
    color:#666;
    margin-bottom:50px;
}

/* SERVICES */

.services{
    background:#F2EEE7;
}

.service-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.card{
    background:#E9E0D0;
    padding:35px 28px;
    min-height:210px;
    border-radius:8px;
    transition:.3s;
}

.card:nth-child(2){
    background:#C8D1BE;
}

.card:nth-child(3){
    background:#D8C1BC;
}

.card:hover{
    transform:translateY(-6px);
}

.card-number{
    font-size:13px;
    color:#777;
    margin-bottom:35px;
}

.card h3{
    font-family:'Playfair Display',serif;
    font-size:25px;
    margin-bottom:12px;
}

.card p{
    color:#555;
    font-size:14px;
    line-height:1.7;
}

/* PORTFOLIO */

.portfolio{
    background:#C8D1BE;
}

.portfolio-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.project{
    height:280px;
    border-radius:8px;
    overflow:hidden;
    position:relative;
    background:#C9D4D8;
}

.project img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.5s;
}

.project:hover img{
    transform:scale(1.06);
}

.project-label{
    position:absolute;
    bottom:0;
    left:0;
    right:0;
    padding:22px;
    background:linear-gradient(transparent,rgba(0,0,0,.75));
    color:white;
}

.project-label h3{
    font-family:'Playfair Display',serif;
    font-size:21px;
}

/* ABOUT */

.about{
    background:#D8C1BC;
}

.about-box{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
}

.about-text p{
    color:#4d4d4d;
    line-height:1.9;
    margin-bottom:20px;
}

.about-mark{
    height:350px;
    background:#C9D4D8;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
}

.about-mark h2{
    font-family:'Playfair Display',serif;
    font-size:55px;
}

/* CONTACT */

.contact{
    background:#252525;
    color:#F2EEE7;
    text-align:center;
}

.contact .section-sub{
    color:#bbb;
}

.email{
    display:inline-block;
    margin:20px 0;
    font-family:'Playfair Display',serif;
    font-size:clamp(20px,4vw,34px);
    color:#D8C1BC;
    text-decoration:none;
}

footer{
    background:#252525;
    color:#888;
    text-align:center;
    padding:25px;
    border-top:1px solid #444;
    font-size:13px;
}

/* MOBILE */

@media(max-width:750px){

    .navlinks{
        gap:14px;
    }

    .navlinks a{
        font-size:12px;
    }

    .navbar{
        padding:17px 15px;
    }

    .logo{
        font-size:18px;
    }

    section{
        padding:75px 18px;
    }

    .service-grid,
    .portfolio-grid{
        grid-template-columns:1fr;
    }

    .about-box{
        grid-template-columns:1fr;
        gap:35px;
    }

    .about-mark{
        height:250px;
    }

    .section-title{
        font-size:38px;
    }

    .hero p{
        font-size:15px;
    }
}
</style>
</head>

